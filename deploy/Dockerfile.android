FROM node:22.23.0-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends openjdk-17-jdk-headless unzip curl libglu1-mesa libpulse0 libnss3 libx11-6 libxcb1 libxcomposite1 libxcursor1 libxi6 libxtst6 libxrandr2 libxkbcommon0 && rm -rf /var/lib/apt/lists/*
ENV ANDROID_HOME=/opt/android ANDROID_SDK_ROOT=/opt/android JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64
ENV PATH=/opt/android/cmdline-tools/latest/bin:/opt/android/platform-tools:/opt/android/emulator:$PATH
RUN curl -fsSL https://dl.google.com/android/repository/commandlinetools-linux-16111833_latest.zip -o /tmp/sdk.zip && mkdir -p /opt/android/cmdline-tools && unzip -q /tmp/sdk.zip -d /tmp/cmdline && mv /tmp/cmdline/cmdline-tools /opt/android/cmdline-tools/latest && rm /tmp/sdk.zip
RUN yes | sdkmanager --licenses > /dev/null
RUN sdkmanager 'platform-tools' 'platforms;android-36' 'build-tools;36.0.0' 'ndk;27.1.12297006' 'cmake;3.22.1' 'emulator' 'system-images;android-30;google_apis;x86_64'
WORKDIR /app
# AGP 的部分库仍使用 35；预装以免每次短生命周期构建重新下载。
RUN curl -fsSL https://dl.google.com/android/repository/build-tools_r35_linux.zip -o /tmp/build-tools35.zip && unzip -q /tmp/build-tools35.zip -d /tmp/build-tools35 && mv /tmp/build-tools35/android-15 /opt/android/build-tools/35.0.0 && rm -rf /tmp/build-tools35 /tmp/build-tools35.zip
